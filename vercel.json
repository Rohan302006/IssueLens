{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/frontend/pages/landing.html" },
    { "source": "/api/:match*", "destination": "https://issuelens-sbbr.onrender.com/api/:match*" },
    { "source": "/student-dashboard", "destination": "/frontend/pages/student-dashboard.html" },
    { "source": "/student-dashboard.html", "destination": "/frontend/pages/student-dashboard.html" },
    { "source": "/admin-dashboard", "destination": "/frontend/pages/admin-dashboard.html" },
    { "source": "/admin-dashboard.html", "destination": "/frontend/pages/admin-dashboard.html" },
    { "source": "/submit-complaint", "destination": "/frontend/pages/submit-complaint.html" },
    { "source": "/submit-complaint.html", "destination": "/frontend/pages/submit-complaint.html" },
    { "source": "/admin-login", "destination": "/frontend/pages/admin-login.html" },
    { "source": "/admin-login.html", "destination": "/frontend/pages/admin-login.html" },
    { "source": "/login", "destination": "/frontend/pages/index.html" },
    { "source": "/index", "destination": "/frontend/pages/index.html" },
    { "source": "/index.html", "destination": "/frontend/pages/index.html" },
    { "source": "/register", "destination": "/frontend/pages/register.html" },
    { "source": "/register.html", "destination": "/frontend/pages/register.html" },
    { "source": "/landing", "destination": "/frontend/pages/landing.html" },
    { "source": "/landing.html", "destination": "/frontend/pages/landing.html" },
    { "source": "/pages/:path*", "destination": "/frontend/pages/:path*" },
    { "source": "/css/:path*", "destination": "/frontend/css/:path*" },
    { "source": "/js/:path*", "destination": "/frontend/js/:path*" }
  ]
}
