{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/frontend/pages/landing" },
    { "source": "/api/:match*", "destination": "https://issuelens-sbbr.onrender.com/api/:match*" },
    { "source": "/student-dashboard", "destination": "/frontend/pages/student-dashboard" },
    { "source": "/admin-dashboard", "destination": "/frontend/pages/admin-dashboard" },
    { "source": "/submit-complaint", "destination": "/frontend/pages/submit-complaint" },
    { "source": "/admin-login", "destination": "/frontend/pages/admin-login" },
    { "source": "/login", "destination": "/frontend/pages/index" },
    { "source": "/register", "destination": "/frontend/pages/register" },
    { "source": "/pages/:path*", "destination": "/frontend/pages/:path*" },
    { "source": "/css/:path*", "destination": "/frontend/css/:path*" },
    { "source": "/js/:path*", "destination": "/frontend/js/:path*" }
  ]
}
