# ─── Server Configuration ─────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Session Secret ───────────────────────────────────────────
SESSION_SECRET=change_this_to_a_secure_random_string_in_production

# ─── Neon PostgreSQL Connection URL ───────────────────────────
# Format: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
# Copy this directly from your Neon Console (Connection details -> Pooled connection)
DATABASE_URL=postgresql://neondb_owner:npg_examplepassword@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── Admin Account (Seeded securely from .env via seed.js) ─────
# These credentials will be hashed with bcrypt during `npm run seed`.
# Since .env is ignored by Git, your personal credentials remain private.
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_NAME=Your Full Name (Admin)

# ─── Frontend CORS Configuration (Production) ─────────────────
# When your frontend is deployed on Vercel:
# CLIENT_URL=https://your-frontend-app.vercel.app

# ─── Cloudinary Configuration (Free Tier - Option A) ───────────
# Create a free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
